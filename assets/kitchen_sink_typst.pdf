=== Python chunks <python-chunks>



#srcbox[#raw("import math
print(f\"Pi is approximately {math.pi:.4f}\")", block: true, lang: "python")]

#outbox[#raw("> Pi is approximately 3.1416", block: true)]


#srcbox[#raw("squares = [x**2 for x in range(1, 6)]
print(squares)", block: true, lang: "python")]

#outbox[#raw("> [1, 4, 9, 16, 25]", block: true)]

