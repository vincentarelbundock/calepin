{
  "name": "calepin",
  "displayName": "Calepin for Typst",
  "description": "Calepin brings computational notebooks to Typst",
  "version": "0.0.53",
  "publisher": "VincentArel-Bundock",
  "license": "MIT",
  "icon": "logo_short.png",
  "homepage": "https://vincentarelbundock.github.io/calepin",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentarelbundock/calepin"
  },
  "bugs": {
    "url": "https://github.com/vincentarelbundock/calepin/issues"
  },
  "qna": "marketplace",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#40e0d0",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "typst",
    "calepin",
    "notebook",
    "literate programming",
    "python",
    "r",
    "julia",
    "rust"
  ],
  "activationEvents": [
    "onLanguage:typst",
    "workspaceContains:**/*.typ",
    "onCommand:calepin.start",
    "onCommand:calepin.stop"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "calepin.start",
        "title": "Typst: Calepin"
      },
      {
        "command": "calepin.stop",
        "title": "Typst: Stop Calepin"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "calepin.start"
        },
        {
          "command": "calepin.stop"
        }
      ]
    },
    "configuration": {
      "title": "Calepin",
      "properties": {
        "calepin.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the calepin binary. Leave empty to use the bundled binary, then PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.4.0"
  }
}
