{
  "name": "calepin",
  "displayName": "Calepin for Typst",
  "description": "Calepin brings computational notebooks to Typst",
  "version": "0.0.11",
  "publisher": "VincentArel-Bundock",
  "license": "MIT",
  "icon": "logo_short_2.png",
  "homepage": "https://vincentarelbundock.github.io/calepin",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentarelbundock/calepin"
  },
  "bugs": {
    "url": "https://github.com/vincentarelbundock/calepin/issues"
  },
  "qna": "marketplace",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#40e0d0",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "typst",
    "calepin",
    "notebook",
    "literate programming",
    "python",
    "r",
    "julia",
    "rust"
  ],
  "activationEvents": [
    "onLanguage:typst",
    "workspaceContains:**/*.typ",
    "onCommand:calepin.watch",
    "onCommand:calepin.compile",
    "onCommand:calepin.stop",
    "onCommand:calepin.new",
    "onCommand:calepin.openPreview",
    "onCommand:calepin.restartPreview",
    "onCommand:calepin.stopPreview",
    "onCommand:calepin.refreshExecution"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "calepin.watch",
        "title": "Calepin Typst Watch"
      },
      {
        "command": "calepin.compile",
        "title": "Calepin Typst Compile"
      },
      {
        "command": "calepin.stop",
        "title": "Calepin Typst Stop"
      },
      {
        "command": "calepin.new",
        "title": "Calepin Typst New"
      },
      {
        "command": "calepin.openPreview",
        "title": "Calepin: Open Preview"
      },
      {
        "command": "calepin.restartPreview",
        "title": "Calepin: Restart Preview"
      },
      {
        "command": "calepin.stopPreview",
        "title": "Calepin: Stop Preview"
      },
      {
        "command": "calepin.refreshExecution",
        "title": "Calepin: Refresh Execution"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "calepin.watch"
        },
        {
          "command": "calepin.compile"
        },
        {
          "command": "calepin.stop"
        },
        {
          "command": "calepin.new"
        },
        {
          "command": "calepin.openPreview"
        },
        {
          "command": "calepin.restartPreview"
        },
        {
          "command": "calepin.stopPreview"
        },
        {
          "command": "calepin.refreshExecution"
        }
      ]
    },
    "configuration": {
      "title": "Calepin",
      "properties": {
        "calepin.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the calepin binary. Leave empty to use the bundled binary, then PATH."
        },
        "calepin.watchFormat": {
          "type": "string",
          "enum": [
            "pdf",
            "html",
            "svg",
            "png"
          ],
          "default": "pdf",
          "description": "Output format for Calepin Typst Watch."
        },
        "calepin.watchTypstArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments forwarded to typst watch after --, such as --port, --open, or --font-path."
        },
        "calepin.preview.debounceMs": {
          "type": "number",
          "default": 250,
          "description": "Delay before sending editor changes to the live preview."
        },
        "calepin.preview.format": {
          "type": "string",
          "enum": [
            "pdf"
          ],
          "default": "pdf",
          "description": "Output format for Calepin live preview."
        },
        "calepin.preview.noExec": {
          "type": "boolean",
          "default": true,
          "description": "Reuse cached chunk outputs instead of executing code during live preview."
        },
        "calepin.preview.preserveScroll": {
          "type": "boolean",
          "default": true,
          "description": "Preserve preview scroll position across updates."
        },
        "calepin.preview.extraTypstArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments forwarded to Typst after -- during live preview."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
